# Local PostgreSQL container
# 5437 instead of the default 5432, so it doesn't clash with a
# PostgreSQL installed directly on Windows/macOS.
POSTGRES_USER=hospedaplus
POSTGRES_PASSWORD=hospedaplus
POSTGRES_DB=hospedaplus
POSTGRES_PORT=5437

# Where the seed connects (from your machine) 
DATABASE_URL=postgresql://hospedaplus:hospedaplus@localhost:5437/hospedaplus

# Tests only: a throwaway database, it gets wiped 
TEST_DATABASE_URL=postgresql://hospedaplus:hospedaplus@localhost:5437/hospedaplus_test

# Seed behaviour 
SEED_MODE=dev                 # dev (120 nights, 40k guests) or full (580 nights, 100k guests)
SEED_RANDOM_SEED=42           # same seed + same start date = same data

# The simulation's "today": history ends the day before, future bookings
# start on it. Leave it commented to use the real date. Pin it (e.g. in CI)
# when the data must be identical on any day. No spaces around the "=".
# SEED_START_DATE=2026-10-14

SEED_ZERO_GUESTS_RATE=0.02    # injected defects (statement 5.3 / US-26)
SEED_INVALID_DATES_RATE=0.02
SEED_ALLOW_REMOTE=false       # keep false; use --allow-remote on purpose instead